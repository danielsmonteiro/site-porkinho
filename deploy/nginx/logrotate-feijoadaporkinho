# ------------------------------------------------------------------------
# Feijoada Porkinho — retencao de logs (LGPD)
# Instalar em: /etc/logrotate.d/feijoadaporkinho
#
# POR QUE OS LOGS NAO FICAM EM /var/log/nginx:
# o pacote nginx do Ubuntu ja traz /etc/logrotate.d/nginx cobrindo
# /var/log/nginx/*.log. Listar os mesmos arquivos aqui faz o logrotate
# abortar com "duplicate log entry" e PULAR o arquivo do pacote inteiro —
# na pratica, access.log e error.log do nginx deixavam de ser rotacionados
# e o `logrotate` diario passava a sair com erro. Com os nossos logs em
# diretorio proprio, as duas regras convivem sem se cruzar.
#
# Os logs guardam endereco IP, que e dado pessoal. A retencao e de 30 dias.
#
# Conferir (o ensaio GLOBAL e que mostra colisao; o do arquivo isolado nao):
#     sudo logrotate -d /etc/logrotate.conf
# ------------------------------------------------------------------------

/var/log/feijoadaporkinho/*.log {
    daily
    rotate 30
    maxage 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    su root adm
    sharedscripts
    postrotate
        if [ -f /var/run/nginx.pid ]; then
            kill -USR1 "$(cat /var/run/nginx.pid)"
        fi
    endscript
}
