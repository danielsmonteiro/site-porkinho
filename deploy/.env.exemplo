# Copie para deploy/.env e preencha. O arquivo .env esta no .gitignore.
#   cp deploy/.env.exemplo deploy/.env

# --- destino da publicacao ---
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_DESTINO=/var/www/feijoadaporkinho/public
DEPLOY_BRANCH=main

# Durante a virada do DNS, aponte a checagem de saude direto para a origem:
#   SAUDE_URL=http://SEU_IP/health
SAUDE_URL=https://feijoadaporkinho.com.br/health

# --- limpeza de cache da Cloudflare (opcional) ---
# Token com permissao Zone > Cache Purge. Nunca commite isto.
CF_ZONE_ID=
CF_API_TOKEN=
