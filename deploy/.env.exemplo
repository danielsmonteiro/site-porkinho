# Copie para deploy/.env e preencha. O arquivo .env esta no .gitignore.
#   cp deploy/.env.exemplo deploy/.env

# --- Cloudflare (Worker) ---
# Account ID: painel da Cloudflare > Workers & Pages > coluna da direita.
# Token: My Profile > API Tokens > Create Token > Custom token, com:
#   Account > Workers Scripts > Edit
#   Account > Account Analytics > Read     (relatorio-cliques.sh)
#   Zone    > Workers Routes > Edit        (zona feijoadaporkinho.com.br)
#   Zone    > Zone > Read                  (zona feijoadaporkinho.com.br)
# Nunca commite isto.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
